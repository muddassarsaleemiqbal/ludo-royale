{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ludo Royale",
  "version": "0.1.15",
  "identifier": "dev.ludo.royale",
  "build": {
    "beforeDevCommand": "pnpm --dir ../client dev",
    "beforeBuildCommand": "node ../../scripts/build-web.mjs --require-api-url",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ludo Royale",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
