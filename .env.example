DATABASE_URL=postgresql://postgres:password@localhost:5432/ludo
# Server-only key from Ably Dashboard → API Keys. Never prefix this with VITE_.
ABLY_API_KEY=your-app-id.your-key-id:your-key-secret
LUDO_SERVER_ADDR=0.0.0.0:8080
# Include the web deployment plus both Tauri desktop WebView origins.
LUDO_ALLOWED_ORIGINS=http://localhost:5173,https://your-project.vercel.app,tauri://localhost,http://tauri.localhost,https://tauri.localhost
LUDO_ENV=development
LUDO_DB_MAX_CONNECTIONS=20
LUDO_DB_MIN_CONNECTIONS=2
LUDO_DB_ACQUIRE_TIMEOUT_SECONDS=5
LUDO_DB_IDLE_TIMEOUT_SECONDS=300
LUDO_OUTBOUND_QUEUE_CAPACITY=256
# Required only when the admin API is enabled.
LUDO_ADMIN_TOKEN=
LUDO_FEATURE_RANKED=true
LUDO_FEATURE_SOCIAL=true
LUDO_FEATURE_REPLAYS=true
VITE_API_URL=http://localhost:8080
